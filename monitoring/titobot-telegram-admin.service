[Unit]
Description=TitoBot Telegram monitor administration (independent of trading)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/titobot
EnvironmentFile=/etc/titobot-monitor/admin.env
ExecStart=/root/titobot/venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8766 --timeout 60 dashboard.telegram_standalone:create_app()
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/titobot/data /etc/titobot-monitor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
