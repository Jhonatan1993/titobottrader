[Unit]
Description=TitoBot read-only Telegram monitor
After=network-online.target titobot-monitor-snapshot.service
Wants=network-online.target

[Service]
Type=simple
User=titomonitor
Group=titomonitor
EnvironmentFile=/etc/titobot-monitor/telegram.env
ExecStart=/usr/bin/python3 /opt/titobot-monitor/telegram_readonly_monitor.py --history /var/lib/titobot-monitor/snapshot/trades.json --state /var/lib/titobot-monitor/state/state.json --balance /var/lib/titobot-monitor/snapshot/practice_balance.json --interval 30
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/titobot-monitor/state
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
